{
  "name": "product-analytics",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:convex": "convex dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p convex --noEmit",
    "test": "vitest run",
    "test:convex": "vitest run --project convex",
    "lint": "turbo run lint",
    "seed:demo": "bun scripts/seed-demo.ts",
    "dev:dashboard": "turbo run dev --filter=@analytics/dashboard",
    "build:sdk": "turbo run build --filter=@analytics/react-native"
  },
  "dependencies": {
    "@analytics/shared": "workspace:*",
    "@auth/core": "^0.41.1",
    "@convex-dev/auth": "^0.0.95",
    "convex": "^1.46.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.10.0",
    "convex-test": "^0.0.60",
    "turbo": "^2.11.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
